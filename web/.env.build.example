# =============================================================================
# Ansvisor web — BUILD-TIME env (public values only)
# Copy to web/.env.build before running deploy/ec2/build-and-push.sh.
# Everything here is inlined into the browser bundle: NEVER put a secret here.
# Only NEXT_PUBLIC_* keys are allowed; the build script refuses anything else.
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://server:80
NEXT_PUBLIC_APP_URL=https://aeo.b0tc0.net
NEXT_PUBLIC_IS_CLOUD=false

# Optional
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_ACTION_TASKS_AI=
NEXT_PUBLIC_CONTENT_QUALITY_PHASE=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
