# =============================================================================
# Ansvisor web — RUNTIME env for the EC2 VM (copy to /opt/ansvisor/web.env)
# Derived from web/.env.example. Server-side secrets live ONLY here (never in
# web/.env.build or the image). The NEXT_PUBLIC_* values below must match the
# ones in web/.env.build that the image was built with: the browser bundle
# already has them inlined, so changing them here alone has no effect there.
# =============================================================================

# --- Public (same values as web/.env.build) ---------------------------------
# NEXT_PUBLIC_API_URL is how the web container reaches the server: the compose
# service name, never a hostname behind Cloudflare Access (its server-side
# calls carry no Access login). Browsers go through the web app's /api/aeo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://server:80
NEXT_PUBLIC_APP_URL=https://aeo.b0tc0.net
NEXT_PUBLIC_IS_CLOUD=false
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_ACTION_TASKS_AI=
NEXT_PUBLIC_CONTENT_QUALITY_PHASE=

# --- Supabase service_role key (server-side, REQUIRED) -----------------------
# The web app's server code uses an admin client (src/lib/supabase/admin.ts)
# for MCP auth, content drafts, quotas, member emails and more. Same value as
# the server's SUPABASE_SERVICE_ROLE_KEY. Never put it in web/.env.build.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI API keys (server-side) ----------------------------------------------
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
GROK_API_KEY=

# Agent BYOK master key (cloud only; self-host can leave blank and uses
# ANTHROPIC_API_KEY directly). Generate: openssl rand -base64 32
ANSVISOR_ENCRYPTION_KEY=

# --- Cloud only (not needed for self-hosted) --------------------------------
# Must match the server's CRON_SECRET. Generate: openssl rand -hex 32
# CRON_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_STARTER_MONTHLY_PRICE_ID=
# STRIPE_GROWTH_MONTHLY_PRICE_ID=
# STRIPE_STARTER_ANNUAL_PRICE_ID=
# STRIPE_GROWTH_ANNUAL_PRICE_ID=
